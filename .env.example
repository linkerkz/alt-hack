# Скопируйте в .env.local и заполните. lib/env.ts падает при старте,
# если обязательной переменной нет.

# Supabase: Project Settings → API. Секретный ключ — только на сервере.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenRouter. Без ключа приложение стартует и камера работает без разбора
# снимка, но шаг «Сформировать план работ» (наряд бригаде) не пройдёт.
OPENROUTER_API_KEY=
# Модель для снимка камеры (vision); по умолчанию google/gemini-2.5-flash.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
# Модель для плана работ (текст).
OPENROUTER_TEXT_MODEL=
OPENROUTER_TEXT_FALLBACK_MODEL=
